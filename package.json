{
  "name": "bongo-ai",
  "version": "1.0.0",
  "description": "Bengali Study Assistant for Bangladesh",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/backend/*"
  ],
  "scripts": {
    "mobile": "yarn workspace @bongo-ai/mobile start",
    "web": "yarn workspace @bongo-ai/web dev",
    "desktop": "yarn workspace @bongo-ai/desktop dev",
    "backend:auth": "yarn workspace @bongo-ai/auth-service dev",
    "backend:content": "yarn workspace @bongo-ai/content-service dev",
    "backend:ai": "yarn workspace @bongo-ai/ai-service dev",
    "backend:analytics": "yarn workspace @bongo-ai/analytics-service dev",
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "terraform:init": "cd infrastructure/terraform && terraform init",
    "terraform:plan": "cd infrastructure/terraform && terraform plan",
    "terraform:apply": "cd infrastructure/terraform && terraform apply"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "typescript": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "resolutions": {
    "@babel/core": ">=7.29.6 <8",
    "@babel/plugin-transform-modules-systemjs": ">=7.29.4 <8",
    "@tootallnate/once": ">=2.0.1 <3",
    "@xmldom/xmldom": ">=0.8.13 <1",
    "axios": ">=1.18.0 <2",
    "convict": ">=6.2.5 <7",
    "diff": ">=4.0.4 <5",
    "fast-uri": ">=3.1.2 <4",
    "flatted": ">=3.4.2 <4",
    "follow-redirects": ">=1.16.0 <2",
    "handlebars": ">=4.7.9 <5",
    "http-proxy-middleware": ">=2.0.10 <3",
    "joi": ">=17.13.4 <18",
    "jws": ">=3.2.3 <4",
    "launch-editor": ">=2.14.1 <3",
    "lodash": ">=4.18.0 <5",
    "node-forge": ">=1.4.0 <2",
    "path-to-regexp": ">=0.1.13 <1",
    "picomatch": ">=2.3.2 <3",
    "qs": ">=6.15.2 <7",
    "shell-quote": ">=1.8.4 <2",
    "tmp": ">=0.2.6 <1",
    "webpack": ">=5.104.1 <6",
    "websocket-driver": ">=0.7.5 <1",
    "yaml": ">=2.8.3 <3"
  }
}