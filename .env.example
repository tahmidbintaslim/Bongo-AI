# Every variable the backend services read. Nothing else is used yet.
#
# docker compose reads this file from the repo root as .env. A service started
# with `yarn workspace @bongo-ai/<service> dev` loads .env from its own folder
# (apps/backend/<service>/.env), so copy the file there or export the
# variables in your shell. Each service has its own default PORT; do not set
# one PORT for all of them.

# Required by the auth, content, ai and analytics services. They refuse to
# start if it is unset or shorter than 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Exact browser origins allowed to call the services, comma separated, for
# example http://localhost:3000,https://app.example.com. Empty blocks every
# cross-origin browser request. Wildcards and trailing slashes are rejected.
CORS_ORIGINS=http://localhost:3000

# AI service: provider and keys
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
COHERE_API_KEY=

# AI service: per-user limits on every /api/ai/* request
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_MAX_BODY_BYTES=16384

# AI service: Pinecone client. Search is mocked and nothing calls insert yet.
VECTOR_STORE_PROVIDER=pinecone
VECTOR_INDEX_NAME=bongo-ai
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# Per-IP limit for the auth, content and analytics services
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API gateway upstreams
AUTH_SERVICE_URL=http://localhost:4001
CONTENT_SERVICE_URL=http://localhost:4002
AI_SERVICE_URL=http://localhost:4003
ANALYTICS_SERVICE_URL=http://localhost:4004

# Logging. The ai, auth and gateway services read LOGGING_LEVEL; content and
# analytics read LOG_LEVEL.
NODE_ENV=development
LOGGING_LEVEL=info
LOG_LEVEL=info
